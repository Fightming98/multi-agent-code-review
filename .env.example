# Application
APP_NAME=multi-agent-code-review
APP_ENV=development
DEBUG=true

# LLM Provider
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Logging
LOG_LEVEL=INFO

# Review Settings
MAX_CONCURRENT_AGENTS=4
MAX_RETRY_ATTEMPTS=2

# Stage 1 repository acquisition limits (docs/acceptance.md §4.7)
GITHUB_ALLOWED_HOST=github.com
GITHUB_ALLOWED_PORT=443
GIT_EXECUTABLE=git
GIT_CLONE_TIMEOUT_SECONDS=300
GIT_COMMAND_TIMEOUT_SECONDS=300
MAX_REPOSITORY_SIZE_MB=200
MAX_FILE_COUNT=5000
MAX_SINGLE_FILE_SIZE_MB=2
MAX_TOTAL_SCAN_SIZE_MB=50
STATIC_TOOL_TIMEOUT_SECONDS=120
STATIC_TOOL_OUTPUT_LIMIT_BYTES=5242880
MAX_TOOL_FINDINGS=1000
PYTEST_TIMEOUT_SECONDS=300
COVERAGE_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_CHARS=60000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TEMPERATURE=0.0
LLM_MAX_FINDING_PROPOSALS=50
TRUSTED_FIXTURE_NAME=trusted_fixture_v1
KEEP_WORKSPACE_ON_FAILURE=false
# WORKSPACE_ROOT=